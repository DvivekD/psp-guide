# PSP Cloud Streaming Server Configuration
# Copy this file to .env and fill in your values
# OR run the setup script which will create it automatically.

# Your server's public IP address (auto-detected by setup script)
BACKEND_IP=YOUR_SERVER_IP

# Ports (defaults are fine for most setups)
GOTUBE_PORT=8082
SPOTIFLAC_PORT=8083
YT2009_PORT=8081

# WARP proxy (installed by setup script)
# Essential for avoiding YouTube rate limits/blocks
PROXY_URL=socks5://127.0.0.1:40000
